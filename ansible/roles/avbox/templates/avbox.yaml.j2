paths:
  state: {{ avbox_state_root }}
  staging: {{ avbox_state_root }}/staging
  jobs: {{ avbox_state_root }}/jobs
  quarantine: {{ avbox_state_root }}/quarantine
  scratch: {{ avbox_state_root }}/scratch
  raw_output: {{ avbox_state_root }}/raw-output
  rules: {{ avbox_config_root }}/rules
  registry: {{ avbox_config_root }}/registry.yaml
storage:
  sqlite_path: {{ avbox_state_root }}/avbox.db
  clean_bytes_retention_hours: 0
  minimum_free_gib: 5
quarantine: {enabled: true, content_addressed: true, immutable_after_admission: true}
runtime:
  worker_concurrency: 2
  default_timeout_seconds: 300
  memory_limit_mib: 1536
  maximum_file_bytes: 1073741824
  use_bubblewrap: true
  default_file_detectors: [clamav, yara, yara-x, loki, maldet]
  max_recursion_depth: 3
  max_children_per_object: 100
  max_total_children: 1000
  max_single_child_bytes: 67108864
  max_total_extracted_bytes: 536870912
  max_expansion_ratio: 100.0
  max_member_name_bytes: 4096
  max_path_depth: 32
  max_extraction_time_seconds: 300
  max_partitions_per_disk: 32
  max_materialized_partition_bytes: 268435456
  max_total_materialized_partition_bytes: 536870912
api:
  host: {{ avbox_api_host }}
  port: {{ avbox_api_port }}
  explicit_lan_exposure: false
web: {enabled: true}
logging: {level: INFO, json: true}
preservation: {external_manifests_enabled: true, bootstrap_import_enabled: true}
rab: {enabled: false, endpoint: null, export_directory: '{{ avbox_state_root }}/rab-export'}
rab_protocol:
  enabled: {{ avbox_rab_protocol_enabled | bool | lower }}
  credential_file: {{ avbox_config_root }}/rab-clients.json
  profiles_file: {{ avbox_config_root }}/analysis-profiles.yaml
  upload_root: {{ avbox_state_root }}/rab-uploads
  maximum_upload_bytes: {{ avbox_rab_maximum_upload_bytes }}
  queue_capacity: {{ avbox_rab_queue_capacity }}
  worker_concurrency: {{ avbox_rab_worker_concurrency }}
