#!/bin/sh
set -eu
ROOT=/srv/avbox-bootstrap
if ! blkid /dev/vdb >/dev/null 2>&1; then
  mkfs.ext4 -L avbox-preservation /dev/vdb
fi
UUID=$(blkid -s UUID -o value /dev/vdb)
if ! grep -q '^UUID=.* /srv/avbox-bootstrap ' /etc/fstab; then
  printf 'UUID=%s /srv/avbox-bootstrap ext4 defaults,nodev,nosuid 0 2\n' "$UUID" >> /etc/fstab
fi
mkdir -p "$ROOT"
mountpoint -q "$ROOT" || mount "$ROOT"
mkdir -p "$ROOT/incoming" "$ROOT/artifacts/installers" "$ROOT/artifacts/definitions" "$ROOT/artifacts/tools" "$ROOT/artifacts/documentation" "$ROOT/manifests" "$ROOT/logs/http"
install -m 0444 /etc/avbox-bootstrap/acquisition.yaml "$ROOT/manifests/acquisition.yaml"
chown -R root:root "$ROOT"
chmod 0755 "$ROOT" "$ROOT/incoming" "$ROOT/artifacts" "$ROOT/manifests" "$ROOT/logs"
systemctl disable avbox-bootstrap-init.service

